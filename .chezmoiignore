# Not a dotfile: herdr-lazy owns this directory and reads/writes it in place via
# HERDR_LAZY_LIST. It lives here to be versioned with the rest of the dotfiles,
# but chezmoi must never render it into $HOME.
herdr

# Crash dumps. MSYS/Cygwin bash drops these in whatever directory it died in, so
# one landing in the source tree would otherwise be deployed to every machine.
# .gitignore keeps them out of the repo; this keeps them out of $HOME.
*.stackdump

